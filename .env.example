# SafeSeat SMS backend — SERVER-SIDE ONLY.
# Never copy these secrets into Expo EXPO_PUBLIC_* variables.

# Required: Firebase Admin service-account JSON.
# Paste the entire JSON as one Vercel environment-variable value.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"safeseat-app","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}

# Optional alternative to FIREBASE_SERVICE_ACCOUNT:
# Base64-encode the complete service-account JSON file and put it here instead.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Required: TextBee API key created in the TextBee dashboard.
TEXTBEE_API_KEY=

# Optional: pin SafeSeat to one registered Android TextBee gateway phone.
# If blank, TextBee uses the account default / most recently active enabled device.
TEXTBEE_DEVICE_ID=

# Keep true for your first deployment test. No SMS is sent while true.
# Change to false and redeploy when you are ready for a real SMS test.
TEST_MODE=true

# Optional comma-separated browser origins allowed to call this API.
# Native Expo requests do not require CORS.
ALLOWED_ORIGINS=https://safeseat-app.vercel.app,http://localhost:8081,http://localhost:19006
